# Django
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL 16 in production; SQLite fallback for tests)
DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# IA — obligatoire pour l'extraction photo (GPT-4o-mini Vision et/ou Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ne pas activer en démo réelle (réservé aux tests pytest)
MONEXA_AI_FALLBACK_MOCK=False

# Django Admin / locale
LANGUAGE_CODE=fr
TIME_ZONE=Africa/Lome

# Django
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Derriere Nginx / tunnel (ajoute ton IP LAN : http://192.168.x.x)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://*.trycloudflare.com
BEHIND_PROXY=False

# Database (PostgreSQL 16 in production; SQLite fallback if empty)
DATABASE_URL=

# Redis (optionnel — cache / files d'attente). Jamais source de vérité financière.
REDIS_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# IA — extraction photo. Si vide : saisie manuelle / SMS restent disponibles.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ne pas activer en production (réservé aux tests pytest)
MONEXA_AI_FALLBACK_MOCK=False

# Seed automatique au démarrage Docker : uniquement développement / démo.
RUN_SEED_DEMO=False

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# TLS (activer derrière un reverse proxy HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Django Admin / locale
LANGUAGE_CODE=fr
TIME_ZONE=Africa/Lome
